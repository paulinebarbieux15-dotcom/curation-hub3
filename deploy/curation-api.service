# systemd service: copy to /etc/systemd/system/curation-api.service
# then: sudo systemctl daemon-reload && sudo systemctl enable --now curation-api
[Unit]
Description=Curation Hub - FastAPI backend + job worker
After=network.target

[Service]
User=curation
WorkingDirectory=/opt/curation-hub/backend
# ONE process only: the job worker and live updates run inside it.
ExecStart=/opt/curation-hub/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
# backend/.env holds secrets: chmod 600, owned by the curation user.

[Install]
WantedBy=multi-user.target
