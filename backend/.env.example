# Copy this file to .env (same folder) and fill in your values.
# .env contains secrets: never commit it, never share it.

# ---------------------------------------------------------------- Internal LLM
# OpenAI-compatible endpoint (POST .../chat/completions)
LLM_URL=https://your-llm-host/v1/chat/completions
LLM_API_KEY=your-api-key
LLM_MODEL=your-model-name
# true = simulated answers (to test without the LLM)
LLM_FAKE=false
# set to false if the LLM rejects "response_format"
LLM_JSON_MODE=true
# Anti-hallucination: a value is kept only if confidence >= threshold
# AND its evidence quote is found in the article (otherwise the field stays empty)
AI_CONFIDENCE_THRESHOLD=0.8
AI_REQUIRE_EVIDENCE=true
# validated records shown to the LLM as tagging examples
AI_FEW_SHOT_EXAMPLES=3

# ---------------------------------------------------------------- Capture
# chrome = use the installed Google Chrome (msedge also works; empty = Playwright Chromium)
BROWSER_CHANNEL=chrome
CAPTURE_FAKE=false

# ---------------------------------------------------------------- AntBox
# Leave empty to auto-detect any .csv/.txt in data/ whose name contains antbox/referentiel/referential
# REFERENTIAL_FILE=data/referentiel_antbox.csv
AI_SKIPPED_FIELDS=Attachment redactor
REQUIRED_FIELDS=Document type,Domain
CSV_SEPARATOR=;
CSV_MULTI_SEPARATOR=|
# label or id
CSV_VALUES=label

# ---------------------------------------------------------------- Distribution & queue
# max to-do items per analyst before overflow goes to the global queue (0 = no cap)
QUEUE_CAP_PER_USER=15
STALE_WARNING_DAYS=3
STALE_CRITICAL_DAYS=7
JOB_MAX_ATTEMPTS=3
DOMAIN_MIN_INTERVAL_S=2

# ---------------------------------------------------------------- Shared social account
# Random gap between two social captures + daily cap (behave like a human)
SOCIAL_MIN_INTERVAL_S=20
SOCIAL_MAX_INTERVAL_S=40
SOCIAL_DAILY_CAP=150
# Credentials used to log back in automatically when the session expires.
# TOTP = "setup key" shown when adding the account to an authenticator app (optional).
SOCIAL_LINKEDIN_USERNAME=
SOCIAL_LINKEDIN_PASSWORD=
SOCIAL_LINKEDIN_TOTP=
SOCIAL_X_USERNAME=
SOCIAL_X_PASSWORD=
SOCIAL_X_TOTP=
SOCIAL_INSTAGRAM_USERNAME=
SOCIAL_INSTAGRAM_PASSWORD=
SOCIAL_INSTAGRAM_TOTP=
SOCIAL_FACEBOOK_USERNAME=
SOCIAL_FACEBOOK_PASSWORD=
SOCIAL_FACEBOOK_TOTP=

# ---------------------------------------------------------------- Google Chat
# Incoming webhook URL of the team space (empty = no notifications)
GOOGLE_CHAT_WEBHOOK=
# daily digest hour (local time), -1 = off
DIGEST_HOUR=9
PUBLIC_URL=http://localhost:8000

# ---------------------------------------------------------------- Web
CORS_ORIGINS=http://localhost:4200
